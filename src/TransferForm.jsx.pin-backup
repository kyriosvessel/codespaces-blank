import { useState } from 'react';
import { supabase } from './supabase';

export default function TransferForm({ session }) {
  const [walletId, setWalletId] = useState('');
  const [amount, setAmount] = useState('');
  const [loading, setLoading] = useState(false);
  const [notice, setNotice] = useState('');

  async function sendMoney(event) {
    event.preventDefault();
    setNotice('');

    const value = Number(amount);

    if (!walletId.trim()) {
      setNotice('Please enter the recipient Wallet ID.');
      return;
    }

    if (!Number.isFinite(value) || value <= 0) {
      setNotice('Please enter a valid amount in USD.');
      return;
    }

    setLoading(true);

    try {
      const { data, error } = await supabase.rpc('transfer_wallet_funds', {
        p_recipient_wallet_id: walletId.trim(),
        p_amount: value,
      });

      if (error) throw error;

      if (data?.success) {
        setNotice(`Successfully sent $${value.toFixed(2)}.`);
        setWalletId('');
        setAmount('');
      } else {
        setNotice('Transfer could not be completed.');
      }
    } catch (error) {
      setNotice(error.message || 'Transfer failed. Please try again.');
    } finally {
      setLoading(false);
    }
  }

  const inputStyle = {
    width: '100%',
    boxSizing: 'border-box',
    padding: 12,
    marginTop: 6,
    marginBottom: 14,
    border: '1px solid #E6E0F0',
    borderRadius: 9,
    background: '#fff',
    color: '#211630',
    fontSize: 15,
  };

  return (
    <section style={{
      marginTop: 20,
      padding: 22,
      borderRadius: 16,
      background: '#fff',
      border: '1px solid #E6E0F0',
    }}>
      <h3 style={{ marginTop: 0, color: '#512DA8' }}>Send Money</h3>
      <p>Send USD to another KYRIOS wallet using the recipient's KYRIOS Wallet ID.</p>

      <form onSubmit={sendMoney}>
        <label>
          Recipient Wallet ID
          <input
            style={inputStyle}
            value={walletId}
            onChange={(event) => setWalletId(event.target.value)}
            placeholder="e.g. KYR-A81F92C4D7"
            required
          />
        </label>

        <label>
          Amount (USD $)
          <input
            style={inputStyle}
            type="number"
            min="0.01"
            step="0.01"
            value={amount}
            onChange={(event) => setAmount(event.target.value)}
            placeholder="0.00"
            required
          />
        </label>

        <button
          type="submit"
          disabled={loading || !session}
          style={{
            width: '100%',
            padding: 13,
            border: 0,
            borderRadius: 10,
            background: '#512DA8',
            color: '#fff',
            fontWeight: 700,
            fontSize: 15,
            cursor: 'pointer',
          }}
        >
          {loading ? 'Processing...' : 'Send Money'}
        </button>
      </form>

      {notice && (
        <p role="status" style={{ marginBottom: 0, overflowWrap: 'anywhere' }}>
          {notice}
        </p>
      )}
    </section>
  );
}
