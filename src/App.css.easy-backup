.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}

/* KYRIOS wallet card improvements */
.wallet-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 20px;
  margin: 18px 0;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
  color: #172033;
  overflow-wrap: anywhere;
}

.wallet-card h2 {
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 18px;
  color: #123b73;
}

.transaction-item {
  padding: 12px 0;
}

.transaction-item p {
  margin: 8px 0;
  line-height: 1.5;
}

.transaction-item small {
  color: #64748b;
  font-size: 12px;
}

.transaction-item hr {
  border: 0;
  border-top: 1px solid #e5e7eb;
  margin-top: 16px;
}

@media (max-width: 600px) {
  .wallet-card {
    padding: 16px;
    border-radius: 14px;
  }

  .wallet-card h2 {
    font-size: 18px;
  }
}

/* KYRIOS Professional Navy and White Theme */
:root {
  --kyrios-navy: #123b73;
  --kyrios-blue: #1d4ed8;
  --kyrios-light: #eff6ff;
  --kyrios-white: #ffffff;
  --kyrios-text: #172033;
}

body {
  background: #f3f6fb;
  color: var(--kyrios-text);
  font-family: Arial, Helvetica, sans-serif;
}

button {
  border-radius: 10px;
  font-weight: 600;
  transition: background-color 0.2s ease;
}

input, select, textarea {
  max-width: 100%;
  box-sizing: border-box;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  padding: 11px 12px;
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid #93c5fd;
  border-color: var(--kyrios-blue);
}

.wallet-card {
  background: var(--kyrios-white);
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 20px;
  margin: 18px 0;
  box-shadow: 0 5px 18px rgba(18, 59, 115, 0.07);
}

.wallet-card h2 {
  color: var(--kyrios-navy);
}

@media (max-width: 600px) {
  body {
    font-size: 15px;
  }

  .wallet-card {
    padding: 16px;
    margin: 12px 0;
  }

  button {
    min-height
: 42px;
  }
}

.deposit-status {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
}

.status-pending {
  background: #fef3c7;
  color: #92400e;
}

.status-approved {
  background: #dcfce7;
  color: #166534;
}

.status-rejected {
  background: #fee2e2;
  color: #991b1b;
}


/* KYRIOS account balance card */
.kyrios-balance-card {
  background: linear-gradient(135deg, #123b73, #1d4ed8);
  color: #ffffff;
  border-radius: 18px;
  padding: 24px 20px;
  margin: 16px 0 22px;
  box-shadow: 0 8px 22px rgba(18, 59, 115, 0.18);
  overflow-wrap: anywhere;
}
.kyrios-balance-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  margin: 0 0 12px;
  opacity: 0.9;
}
.kyrios-balance-card .kyrios-balance-amount {
  color: #ffffff;
  font-size: clamp(25px, 6vw, 34px);
  margin: 0;
  font-weight: 700;
}
.kyrios-balance-footer {
  font-size: 12px;
  margin: 14px 0 0;
  opacity: 0.85;
}


/* KYRIOS Premium Brand and Welcome Header */
h1 {
  color: #102a56;
  font-size: clamp(1.8rem, 6vw, 2.6rem);
  font-weight: 900;
  letter-spacing: 1.2px;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: anywhere;
  margin-bottom: 14px;
}

h2 {
  color: #173b70;
  font-weight: 800;
}

body {
  color: #172b4d;
}

.kyrios-brand-title {
  color: #ffffff;
  background: linear-gradient(135deg, #071a38, #174b8a);
  padding: 22px 16px;
  border-radius: 16px;
  text-align: center;
  font-size: clamp(1.5rem, 5vw, 2.2rem);
  font-weight: 900;
  letter-spacing: 1px;
  box-shadow: 0 8px 24px rgba(7, 26, 56, 0.2);
}

.kyrios-user-greeting {
  display: block;
  color: #102a56;
  font-size: clamp(1.2rem, 4vw, 1.6rem);
  font-weight: 800;
  text-align: center;
  margin: 18px 0 8px;
  overflow-wrap: anywhere;
}

@media (max-width: 480px) {
  h1 {
    letter-spacing: 0.5px;
  }
}
